FROM registry.access.redhat.com/hi/go:latest-fips-builder@sha256:f42ef98620724069ec6ee4eb92286f68222352898c971f30f69867db41362052

USER root

RUN mkdir -p /go /tmp/.cache/go-build /tmp/gomodcache && \
    chmod 777 /go /tmp/.cache/go-build /tmp/gomodcache

ENV GOPATH=/go
ENV GOCACHE=/tmp/.cache/go-build
ENV GOMODCACHE=/tmp/gomodcache
